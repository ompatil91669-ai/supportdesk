generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  Open
  Closed
  Pending
}

model Ticket {
  id        String       @id
  name      String
  email     String
  status    TicketStatus @default(Open)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([email])
  @@index([status])
}